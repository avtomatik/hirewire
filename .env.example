###############################################################################
# Application
###############################################################################
HIREWIRE_ENVIRONMENT=development
HIREWIRE_DEBUG=false
HIREWIRE_LOG_LEVEL=INFO
###############################################################################
# Optional Google Workspace integration
###############################################################################
HIREWIRE_GOOGLE__FOLDER_ID=000000ZZZZZZZZZZZZZZzzzzzzzzzzzzz
HIREWIRE_GOOGLE__SPREADSHEET_ID=your-spreadsheet-id
HIREWIRE_GOOGLE__OAUTH_CLIENT_FILE=credentials/oauth-client.json
HIREWIRE_GOOGLE__TOKEN_FILE=credentials/token.json
###############################################################################
# HeadHunter API - disabled by default; configure only after authorization
###############################################################################
HIREWIRE_HHRU__API_ENABLED=false
# HIREWIRE_HHRU__OAUTH__CLIENT_ID=your-authorized-client-id
# HIREWIRE_HHRU__OAUTH__CLIENT_SECRET=your-authorized-client-secret
# HIREWIRE_HHRU__OAUTH__REDIRECT_PORT=8080
# HIREWIRE_HHRU__TOKEN_STORE__PATH=.state/hhru/tokens.json
# For an older SkillMapper token without migrating files:
# HIREWIRE_HHRU__TOKEN_STORE__PATH=.state/tokens.json
